# Configurações do Backend
# Copie este arquivo para .env e configure os valores

# Configurações do Servidor
PORT=3000
NODE_ENV=development

# Configurações de CORS para desenvolvimento
# Em desenvolvimento, deixe vazio para permitir todas as origens
# Em produção, configure com as URLs permitidas separadas por vírgula
CORS_ORIGIN=
PUBLIC_HOST=

# Configurações do Banco de Dados
DB_HOST=localhost
DB_PORT=5432
DB_NAME=restaurant_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Configurações da OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Configurações de Segurança
JWT_SECRET=your_jwt_secret_here
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Configurações de Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Configurações de Logs
LOG_LEVEL=info
LOG_FILE=server.log

# Configurações de Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# Configurações de Moeda (Metical - MZN)
CURRENCY_SYMBOL=MT
CURRENCY_CODE=MZN
CURRENCY_LOCALE=pt-MZ

# Configurações de Timezone
TIMEZONE=Africa/Maputo

# Configurações de WebSocket
WS_HEARTBEAT_INTERVAL=30000
WS_MAX_CLIENTS=100

# Configurações de Notificações
ENABLE_PUSH_NOTIFICATIONS=true
PUSH_NOTIFICATION_KEY=your_push_key_here
